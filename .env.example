# Database (required)
DATABASE_URL=

# Supabase migration helper (optional, fallback for DATABASE_URL)
SUPABASE_DATABASE_URL=

# Supabase Storage (required for database-managed gallery uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GALLERY_BUCKET=gallery-media
NEXT_PUBLIC_SUPABASE_GALLERY_BUCKET=gallery-media

# Email (required for team notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=support@tamibedford.com

# Site (used in admin notification links)
NEXT_PUBLIC_SITE_URL=

# Admin panel (required for /admin access)
# ADMIN_PASSWORD: the shared team password for the admin panel
# ADMIN_SESSION_SECRET: long random string used to sign session cookies
#   (generate with: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Error monitoring (optional — set to enable Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# CAPTCHA (optional — set to enable Cloudflare Turnstile on the form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
